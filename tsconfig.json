{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    "types": ["node"],

    "forceConsistentCasingInFileNames": true
  },

  "include": [
    "index.ts",
    "drizzle.config.ts",
    "src/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}