{
  "name": "salesappbackend",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx -r dotenv/config index.ts",
    "build": "esbuild index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "cross-env NODE_ENV=production node scripts/start-production.mjs",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "stress:kernel": "tsx stress/brixta_kernel_stress.ts",
    "check:full": "npm run check && npm run build && git diff --check",
    "perf:e2e": "python3 scripts/perf-e2e.py",
    "dev:qr-rewards": "cross-env BRIXTA_BACKEND_EDITION=qr-voucher-rewards BRIXTA_INTEGRATION_WORKER=1 NODE_ENV=development tsx -r dotenv/config index.ts",
    "build:qr-rewards": "npm run build",
    "start:qr-rewards": "node scripts/start-qr-rewards.mjs",
    "qr-rewards:provision": "tsx scripts/provision-qr-rewards-runtime.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pg": "^8.20.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.7.0",
    "@types/pg": "^8.21.0",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.27.7",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
